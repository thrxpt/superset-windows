+
+// Bun on Windows materializes workspace deps as directory junctions, and
+// Bun's rmSync() throws EFAULT on junctions. rmdirSync removes the link
+// itself (never following it), so fall back to it.
+function removeLinkSync(linkPath: string): void {
+	try {
+		rmSync(linkPath);
+	} catch {
+		rmdirSync(linkPath);
+	}
